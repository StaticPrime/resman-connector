# ResMan API Configuration
# Copy this file to .env and fill in your actual credentials

# Integration Partner ID (provided by ResMan upon approval)
RESMAN_PARTNER_ID=your-integration-partner-id

# API Key (provided by ResMan upon approval)
RESMAN_API_KEY=your-api-key

# ResMan Account ID (identifies the client account you're accessing)
RESMAN_ACCOUNT_ID=client-account-id

# --- Optional test knobs -------------------------------------------------
# The integration test suite (npm run test:live) needs only the three values
# above. It discovers every other id (property, unit, lease, resident, ...)
# at runtime. These override that behaviour:

# Pin discovery to a specific property instead of auto-selecting one.
# RESMAN_TEST_PROPERTY_ID=

# Subdomain used by the GET /Account/AccountId test. Skipped if unset.
# RESMAN_TEST_SUBDOMAIN=

# Per-request timeout in ms (default 60000).
# RESMAN_TEST_TIMEOUT=60000
